{
  "manifest_version": 3,
  "name": "FORMMATE AI — Voice Form Assistant (Practice)",
  "short_name": "FORMMATE",
  "version": "0.2.0",
  "description": "A practice-only, user-controlled voice and text assistant for understanding and filling web forms.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open FORMMATE"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}